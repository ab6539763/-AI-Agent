# ==============================================================================
# 智枢企业级智能体平台 (ZhiShu-Agent) · Day 56 环境变量模板 (.env.example)
# 使用说明: cp .env.example .env 后填入真实密钥；严禁将 .env 提交至 Git 仓库！
# ==============================================================================

APP_ENV=production
LOG_LEVEL=INFO
API_PORT=8000

# 大模型推理网关配置 (vLLM / OpenAI 兼容接口)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=http://vllm:8001/v1

# 向量数据库与缓存服务连接
QDRANT_URL=http://qdrant:6333
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# 本地结构化状态库
SQLITE_DB_PATH=/app/data/zhishu.db

# 鉴权密钥占位符
JWT_SECRET_KEY=change_me_jwt_secret_key
